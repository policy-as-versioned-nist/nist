{
  "type": "object",
  "required": [
    "schema",
    "target",
    "question",
    "probability",
    "emitted_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "publisher-reliability/forecast-v1"
    },
    "target": {
      "type": "object",
      "required": [
        "publisher",
        "name",
        "tag",
        "commit",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "proposition",
        "resolution_window_opens_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "proposition": {
          "type": "string",
          "minLength": 1
        },
        "resolution_window_opens_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "probability": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "emitted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
