{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "targets",
    "pairs"
  ],
  "properties": {
    "schema": {
      "const": "publisher-reliability/inputs-v1"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publisher",
          "name",
          "tag",
          "commit",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "forecast",
          "resolution"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "forecast": {
            "type": "object",
            "required": [
              "party",
              "tag",
              "commit",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "party": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "resolution": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "party",
                  "tag",
                  "commit",
                  "path"
                ],
                "additionalProperties": false,
                "properties": {
                  "party": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
