{
  "type": "object",
  "required": [
    "schema",
    "forecast",
    "question",
    "observed",
    "resolved_at",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "publisher-reliability/resolution-v1"
    },
    "forecast": {
      "type": "object",
      "required": [
        "party",
        "tag",
        "commit",
        "path",
        "git_blob"
      ],
      "additionalProperties": false,
      "properties": {
        "party": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "proposition",
        "resolution_window_opens_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "proposition": {
          "type": "string",
          "minLength": 1
        },
        "resolution_window_opens_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "observed": {
      "type": "boolean"
    },
    "resolved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "string",
      "pattern": "^https://[^ ]+$"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
